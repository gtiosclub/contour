# Contour — code ownership
#
# One package, one team. The point of the layout is that a PR to one team's
# package never needs another team's review — except for ContourCore, which
# needs all three teams' leads.
#
# TODO(leads): these are the GitHub teams to create under the gtiosclub org.
# Nothing here routes until the teams exist and the handles resolve. Until then
# CODEOWNERS is documentation, not enforcement, and the ContourCore gate is
# honour-system.
#
#   @gtiosclub/contour-leads        every lead, all three teams
#   @gtiosclub/contour-surface      Surface Understanding
#   @gtiosclub/contour-tracking     Tracking / Spatial
#   @gtiosclub/contour-experience   Experience

# Fallback: anything not matched below goes to the leads.
*                                   @gtiosclub/contour-leads

# ── THE CONTRACT ─────────────────────────────────────────────────────────────
# Frozen end of Week 2. Every team's leads review. Do not narrow this list.
/Packages/ContourCore/              @gtiosclub/contour-surface @gtiosclub/contour-tracking @gtiosclub/contour-experience @gtiosclub/contour-leads

# ── TEAM PACKAGES ────────────────────────────────────────────────────────────
/Packages/SurfaceUnderstanding/     @gtiosclub/contour-surface
/Packages/Tracking/                 @gtiosclub/contour-tracking

# Experience owns three packages and the Harness. They stay separate packages so
# that the isolation rule still applies between them — ContourFeedback cannot
# import ContourUI, same as anyone else.
/Packages/ContourFeedback/          @gtiosclub/contour-experience
/Packages/ContourUI/                @gtiosclub/contour-experience

# ── SHARED ───────────────────────────────────────────────────────────────────
# Every team's tests build against the mocks, so the leads review alongside
# Experience — a careless change here breaks all three teams' tests at once.
/Packages/ContourMocks/             @gtiosclub/contour-experience @gtiosclub/contour-leads

# The wiring. Whoever is switching their package on edits this.
/ContourApp/                        @gtiosclub/contour-leads

# Experience's rig — they own it, but anyone may add a control they need.
/Harness/                           @gtiosclub/contour-experience

# ── PLUMBING ─────────────────────────────────────────────────────────────────
/.github/                           @gtiosclub/contour-leads
/Scripts/                           @gtiosclub/contour-leads
/Contour.xcworkspace/               @gtiosclub/contour-leads
