# macOS
.DS_Store

# Xcode — per-user state. Shared schemes live in xcshareddata and ARE committed.
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xccheckout
*.xcscmblueprint
*.moved-aside

# Xcode — build output
DerivedData/
build/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/

# Package.resolved is intentionally NOT ignored for the app and workspace:
# everything we depend on is a local path package, so the file stays tiny and
# pinning it keeps four teams on identical inputs.

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Secrets — never commit a signing identity or an API key
.env
*.xcconfig.local
*.p12
*.mobileprovision

# Server (Firebase Cloud Functions)
Server/functions/node_modules/
# Emulator-only files. .secret.local holds a real OpenAI key.
Server/functions/*.local
# Firebase CLI and emulator logs. A failed `functions:secrets:set` leaves
# firebase-debug.log behind with the request body, key included.
Server/**/firebase-debug*.log
Server/**/*-debug.log

# Editors
.vscode/
.idea/
*.swp
