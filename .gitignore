# macOS
.DS_Store

# Xcode — per-user state. Shared schemes live in xcshareddata and ARE committed.
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xccheckout
*.xcscmblueprint
*.moved-aside

# Xcode — build output
DerivedData/
build/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/

# Package.resolved is intentionally NOT ignored for the app and workspace:
# everything we depend on is a local path package, so the file stays tiny and
# pinning it keeps four teams on identical inputs.

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Secrets — never commit a signing identity or an API key
.env
*.xcconfig.local
*.p12
*.mobileprovision

# Editors
.vscode/
.idea/
*.swp
